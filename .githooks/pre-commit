#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
mapfile -t STAGED < <(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(rs|sh|toml)$|^initramfs/init$')

[ "${#STAGED[@]}" -eq 0 ] && exit 0

if ! "$ROOT/scripts/check-comments.sh" "${STAGED[@]}"; then
  echo ""
  echo "commit blocked. run scripts/check-comments.sh to see what is left."
  exit 1
fi
